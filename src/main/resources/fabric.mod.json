  ],
  "contact": {
    "homepage": "https://github.com/StarSNG25/better-ping-display-fabric",
    "sources": "https://github.com/StarSNG25/better-ping-display-fabric",
    "issues": "https://github.com/StarSNG25/better-ping-display-fabric/issues"
  },

  "license": "MIT",
  "icon": "assets/betterpingdisplay/icon.png",

